{
  "schema_version": 2,
  "status": "entry_contract",
  "scope": ["builtin.marketing-copy", "builtin.viral-titles"],
  "shared_rules": {
    "model_source": "existing AppLLMPort/local-default",
    "fact_policy": "only use supplied project/context facts; never invent price, address, efficacy, dates, or guarantees",
    "persisted_secrets": "reject provider/model/base_url/api_key/model_profile_ref/authorization/cookie",
    "output_validation": "validate JSON shape, required counts, text limits, platform hard limits, and unsupported concrete facts; do not judge subjective quality",
    "repair_policy": {
      "max_attempts": 1,
      "trigger": ["invalid_json", "missing_required_fields", "schema_mismatch"],
      "on_failure": "emit_original_error_code",
      "preserve_input": true
    },
    "legacy_read": [1]
  },
  "marketing_copy": {
    "input_schema_ref": "marketing-copy-input.v2",
    "output_schema_ref": "marketing-copy-output.v2",
    "required_input": ["marketing_goal", "offer_name", "audience"],
    "required_output": ["variants"],
    "variant_fields": ["full_text"],
    "required_output_schema": {
      "type": "object",
      "required": ["variants"],
      "properties": {
        "variants": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "marketing-copy-output.v2.schema.json#/$defs/variant"}
        }
      },
      "additionalProperties": false
    },
    "variant_schema": {
      "type": "object",
      "required": ["full_text"],
      "properties": {"full_text": {"type": "string", "minLength": 1, "maxLength": 5000}},
      "additionalProperties": false
    },
    "variant_count": {"min": 3, "max": 3},
    "generation_jobs": ["direct benefit", "concrete consumption scene", "natural owner/store voice"],
    "artifact_binding": {
      "artifact_type": "copywriting",
      "schema_version": 2,
      "legacy_read_schema_versions": [1],
      "handoff_source": "artifact_version_id",
      "handoff_targets": ["builtin.viral-titles", "builtin.douyin-carousel", "builtin.digital-human-video"]
    }
  },
  "viral_titles": {
    "input_schema_ref": "viral-titles-input.v2",
    "output_schema_ref": "viral-titles-output.v2",
    "required_input": ["platform", "objective", "count"],
    "required_output": ["candidates"],
    "candidate_fields": ["title"],
    "required_output_schema": {
      "type": "object",
      "required": ["candidates"],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "viral-titles-output.v2.schema.json#/$defs/candidate"}
        }
      },
      "additionalProperties": false
    },
    "candidate_schema": {
      "type": "object",
      "required": ["title"],
      "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 200}},
      "additionalProperties": false
    },
    "candidate_count": {"min": 6, "max": 6},
    "deterministic_rules": {
      "max_characters": 30,
      "character_count": "Unicode code points after no normalization; emoji sequences count as their code points",
      "unsupported_concrete_facts_rejected": true,
      "subjective_duplicate_or_banned_term_checks": false
    },
    "source_requirement": "latest adopted copy is the default; an explicit copy, pasted content, or topic may be selected",
    "artifact_binding": {
      "artifact_type": "title_set",
      "schema_version": 2,
      "legacy_read_schema_versions": [1],
      "handoff_source": "artifact_version_id",
      "handoff_targets": ["builtin.douyin-carousel", "builtin.digital-human-video"]
    }
  },
  "error_matrix": [
    {"case": "missing_llm_configuration", "error_code": "LLM_CONFIGURATION_MISSING", "preserve_input": true},
    {"case": "auth_failure", "error_code": "LLM_AUTH_FAILED", "preserve_input": true},
    {"case": "rate_limited", "error_code": "LLM_RATE_LIMITED", "preserve_input": true},
    {"case": "timeout", "error_code": "LLM_TIMEOUT", "preserve_input": true},
    {"case": "invalid_json_or_missing_fields", "error_code": "STRUCTURED_OUTPUT_INVALID", "preserve_input": true},
    {"case": "empty_provider_output", "error_code": "STRUCTURED_OUTPUT_INVALID", "preserve_input": true},
    {"case": "provider_failure", "error_code": "LLM_PROVIDER_FAILED", "preserve_input": true},
    {"case": "run_cancelled", "error_code": "RUN_CANCELLED", "preserve_input": true}
  ]
}
