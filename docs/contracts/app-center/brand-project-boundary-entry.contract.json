{
  "schema_version": 1,
  "change_request": "CR-BRAND-PROJECT-BOUNDARY-001",
  "stage": "BRAND-PROJECT-0",
  "gate": "PG-BP-A",
  "status": "entry_contract",
  "ownership": {
    "brand_kit": "Enterprise Asset Library is the only long-lived source of brand identity and defaults.",
    "content_project": "ContentProject / My Projects is a workflow container and is never an Asset Library resource kind.",
    "context_snapshot": "Immutable generation facts pin project facts, brand domain revision and media revisions.",
    "relationship": "BrandKit 1:N ContentProject; ContentProject has zero or one BrandKit."
  },
  "field_ownership": {
    "brand_fields": [
      "display_name",
      "logo_ref",
      "store_address",
      "phone",
      "primary_color",
      "secondary_color",
      "font_family",
      "default_subtitle_style",
      "default_bgm_ref",
      "ending_card_text",
      "coupon_phrase"
    ],
    "project_fields": [
